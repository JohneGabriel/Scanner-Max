    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- trilho do mostrador (270°) -->
    <path
        android:pathData="M38.44,69.56 A22,22 0 1,1 69.56,69.56"
        android:strokeColor="#2A3442"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- parte preenchida: de 135° até 300° -->
    <path
        android:pathData="M38.44,69.56 A22,22 0 0,1 65,34.95"
        android:strokeColor="#FFA726"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

